# Secrets must NOT live in the OneDrive project folder.
# Copy this file to:
#   %LOCALAPPDATA%\YanaClinic\.env
# Example full path:
#   C:\Users\<you>\AppData\Local\YanaClinic\.env
#
# serve.ps1 migrates an old project\.env there automatically on first start.
# Override path with env var JARVIS_ENV_FILE if needed.

# Admin panel password (required). Use 10+ unique characters. Never use yana2026.
ADMIN_PASSWORD=

# Public contacts used by booking/Telegram helpers
PHONE_E164=79280000000
TELEGRAM_USER=your_telegram_user

# Optional Telegram order notifications
# Create a bot via @BotFather, paste token here.
TELEGRAM_BOT_TOKEN=
# Optional numeric chat id. Leave empty to auto-detect after /start.
TELEGRAM_CHAT_ID=

# OpenAI — set a spend limit in the OpenAI dashboard.
# Rotate the key if it was ever stored under OneDrive.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional shared secret between serve.ps1 and ai/server.js.
# If empty, serve.ps1 generates a fresh token on each start.
JARVIS_INTERNAL_TOKEN=

# Optional overrides
# DATA_DIR=C:\Users\<you>\AppData\Local\YanaClinic\data
